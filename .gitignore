# ============================================
# 校园跑腿代取快递平台 — .gitignore
# Campus Errand Platform — Git Ignore Rules
# ============================================

# -------------------- Java / Maven --------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven wrapper
.mvn/wrapper/maven-wrapper.properties

# -------------------- Spring Boot --------------------
application-local.yaml
application-local.yml
application-dev.yaml
application-dev.yml

# -------------------- Node / Vue / Vite --------------------
node_modules/
dist/
dist-ssr/
*.local
.env
.env.*
!.env.example

# Build output
build/
out/

# Vite
.vite/

# TypeScript
*.tsbuildinfo

# -------------------- IDE --------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
.nb-gradle/
nbdist/
nbactions.xml
nb-configuration.xml

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# -------------------- OS Files --------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# -------------------- Logs & Temp --------------------
logs/
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.~*

# -------------------- Upload / Media --------------------
# Uploaded images directory (mapped to C:/images/ in dev)
images/
uploads/

# -------------------- Database --------------------
# Sensitive SQL dumps or local DB files
*.sql.gz
data/

# -------------------- Environment & Secrets --------------------
.env.local
.env.*.local
secrets.*
credentials.*
